# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb://localhost:27017/student_mdc_db

# Trusted Frontend Origin (exact origin, required for credentialed CORS)
CLIENT_URL=http://localhost:5173

# JWT Authentication Settings (Use a strong >=32 char random secret in production)
JWT_SECRET=replace_this_with_a_secure_256_bit_random_secret_before_deployment
JWT_EXPIRES_IN=24h
JWT_ISSUER=aktu-sms-api
JWT_AUDIENCE=aktu-sms-client

# Password Hashing (bcrypt work factor)
BCRYPT_SALT_ROUNDS=12

# Cookie & CSRF Configuration
COOKIE_NAME=sms_access_token
CSRF_COOKIE_NAME=sms_csrf_token
COOKIE_SAMESITE=lax

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
